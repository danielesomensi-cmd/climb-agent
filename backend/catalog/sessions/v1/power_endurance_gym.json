{
  "id": "power_endurance_gym",
  "name": "Power Endurance (Gym — Lead Focus)",
  "version": "2.1",
  "intent": {
    "primary_goal": "power_endurance",
    "secondary_goals": [
      "anaerobic_capacity",
      "finger_endurance",
      "core"
    ],
    "notes": "One PE drill: route intervals where the gym has routes, otherwise 4x4 bouldering or linked boulders. Lead-climber focused. One technique rule per set under pump. Submaximal finger repeaters post-climbing."
  },
  "compatibility": {
    "slot": [
      "long"
    ],
    "sports": [
      "climbing"
    ]
  },
  "required_equipment": [
    "gym_boulder"
  ],
  "boulder_fallback": null,
  "time_budget": {
    "target_duration_min": 90,
    "hard_cap_min": 105
  },
  "modules": [
    {
      "template_id": "warmup_climbing",
      "required": true,
      "priority": 100,
      "module_role": "general_warmup"
    },
    {
      "block_id": "technique_drill",
      "required": false,
      "priority": 65,
      "module_role": "secondary",
      "order": "after_warmup",
      "notes": "One technique drill with one measurable target, right after the warm-up while fresh (Daniele, 2026-10-04: every session that is not pure recovery has a technique or try-hard block with a measurable target; limiters: feet, then positioning).",
      "selection": {
        "primary": {
          "exercise_id": "tap_and_place",
          "prescription_overrides": {
            "notes": "3 x 4 easy problems: tap the foothold gently with the toe, lift away, then place it precisely. Target: no foot slips or re-placements on the last set."
          }
        }
      }
    },
    {
      "block_id": "pe_boulder",
      "rotation": "phase_anchor",
      "required": true,
      "priority": 90,
      "module_role": "primary",
      "notes": "One PE block: route intervals where the gym has routes (the gym_routes equipment preference), otherwise one boulder PE drill (4x4, linked boulders) from the phase rotation. The block keeps the id pe_boulder (phase-anchor history). In every set hold one technique rule under pump (see the exercise cues).",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "main"
            ],
            "domain": [
              "power_endurance",
              "anaerobic_capacity"
            ],
            "pattern": [
              "climbing_intervals"
            ],
            "equipment": [
              "gym_routes"
            ]
          }
        }
      }
    },
    {
      "block_id": "finger_endurance",
      "rotation": "phase_anchor",
      "required": false,
      "priority": 80,
      "module_role": "secondary",
      "notes": "Submaximal repeaters post-climbing. Finger endurance stimulus, not max strength: never above medium intensity (no 7/3 after the PE work).",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "main"
            ],
            "domain": [
              "finger_strength_endurance",
              "finger_aerobic_endurance"
            ],
            "pattern": [
              "repeater_hang"
            ],
            "intensity_max": "medium"
          }
        }
      }
    },
    {
      "block_id": "pulling_maintenance",
      "rotation": "ab",
      "unloaded_only": true,
      "ab_pool": ["power_pullups_explosive", "archer_pullup", "one_arm_pullup_assisted"],
      "required": false,
      "priority": 70,
      "module_role": "secondary",
      "notes": "Pulling strength maintenance. Low volume, high intensity — this is not a development block.",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "main"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "pull_vertical"
            ]
          }
        }
      },
      "prescription": {
        "sets": 2,
        "reps": 4,
        "rest_between_sets_seconds": 180,
        "notes": "2 heavy sets, full recovery. If the specific work left you tired, drop a rep — never the load."
      }
    },
    {
      "template_id": "core_standard",
      "required": false,
      "priority": 60,
      "module_role": "secondary"
    },
    {
      "template_id": "antagonist_prehab",
      "required": false,
      "priority": 50,
      "module_role": "secondary"
    },
    {
      "template_id": "cooldown_stretch",
      "required": false,
      "priority": 40,
      "module_role": "cooldown"
    }
  ]
}

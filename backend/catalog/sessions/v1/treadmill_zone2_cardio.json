{
  "id": "treadmill_zone2_cardio",
  "name": "Treadmill Zone 2 Cardio + Hip Mobility",
  "version": "1.0",
  "supplementary": true,
  "intent": {
    "primary_goal": "conditioning",
    "secondary_goals": [
      "aerobic_capacity",
      "mobility"
    ],
    "notes": "Lunch-break aerobic base: 25 min steady Zone 2 on an inclined treadmill, then optional hip mobility. About 35 min. No finger or elbow load and a low recovery cost, so it fits next to any climbing day."
  },
  "compatibility": {
    "slot": [
      "lunch_short",
      "short"
    ],
    "sports": [
      "climbing"
    ]
  },
  "required_equipment": [
    "treadmill"
  ],
  "time_budget": {
    "target_duration_min": 35,
    "hard_cap_min": 45
  },
  "tags": {
    "hard": false,
    "finger": false
  },
  "modules": [
    {
      "block_id": "zone2_main",
      "required": true,
      "priority": 100,
      "module_role": "primary",
      "notes": "Steady Zone 2 incline walk. The first 3-4 min are the warm-up: start slow and let the heart rate settle into the zone.",
      "selection": {
        "primary": {
          "exercise_id": "treadmill_incline_walk",
          "prescription_overrides": {
            "work_seconds": 1500
          },
          "filters": {
            "role": [
              "conditioning"
            ],
            "domain": [
              "aerobic_capacity"
            ],
            "pattern": [
              "locomotion"
            ],
            "intensity_max": "low"
          }
        }
      }
    },
    {
      "block_id": "hip_mobility",
      "required": false,
      "priority": 60,
      "module_role": "cooldown",
      "notes": "Optional hip mobility for high steps and heel hooks. Skip it if the lunch break is short.",
      "selection": {
        "primary": {
          "exercise_id": "hip_opener_flow",
          "prescription_overrides": {
            "work_seconds": 480,
            "notes": "8 min: hold each hip position 45-60 s, breathe deeply. Optional - skip it if the lunch break is short."
          },
          "filters": {
            "role": [
              "cooldown"
            ],
            "domain": [
              "mobility",
              "flexibility"
            ],
            "intensity_max": "low"
          }
        }
      }
    }
  ]
}

{
  "id": "upper_push_arms_lunch",
  "name": "Upper Push + Arms (Lunch)",
  "version": "1.0",
  "supplementary": true,
  "intent": {
    "primary_goal": "strength_general",
    "secondary_goals": [
      "joint_health"
    ],
    "notes": "Lunch-break antagonist session at a weights gym: chest press, triceps and biceps. About 30 min. Balances the pull-dominant climbing pattern without touching the fingers. Biceps are elbow-flexor work: keep them away from the 24 h before a heavy pulling session."
  },
  "compatibility": {
    "slot": [
      "lunch_short",
      "short"
    ],
    "sports": [
      "climbing"
    ]
  },
  "required_equipment": [
    "dumbbell"
  ],
  "time_budget": {
    "target_duration_min": 30,
    "hard_cap_min": 45
  },
  "tags": {
    "hard": false,
    "finger": false
  },
  "modules": [
    {
      "block_id": "pulse_raise",
      "required": true,
      "priority": 110,
      "module_role": "general_warmup",
      "notes": "Short pulse raise before pressing.",
      "selection": {
        "primary": {
          "exercise_id": "general_pulse_raise",
          "filters": {
            "role": [
              "warmup"
            ],
            "domain": [
              "aerobic_capacity"
            ],
            "intensity_max": "low"
          }
        }
      }
    },
    {
      "block_id": "chest_press",
      "required": true,
      "priority": 100,
      "module_role": "primary",
      "notes": "Horizontal press for the chest: bench press with free weights. Without weights it falls back to another push movement.",
      "selection": {
        "primary": {
          "exercise_id": "bench_press",
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "push"
            ],
            "intensity_max": "medium"
          }
        }
      }
    },
    {
      "block_id": "triceps",
      "required": true,
      "priority": 90,
      "module_role": "secondary",
      "notes": "Triceps isolation. Prefers the cable pushdown; without a cable machine it falls back to a light push movement (overhead extension, skullcrusher).",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "push"
            ],
            "equipment": [
              "cable_machine"
            ],
            "intensity_max": "low"
          }
        }
      }
    },
    {
      "block_id": "biceps",
      "required": true,
      "priority": 80,
      "module_role": "secondary",
      "notes": "Elbow flexion: a curl variation for biceps and brachialis (never a weighted pull-up or chin-up).",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "accessory",
              "main"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "elbow_flexion"
            ],
            "intensity_max": "medium"
          }
        }
      }
    }
  ]
}

{
  "id": "treadmill_hiit_4x4",
  "name": "Treadmill HIIT 4x4 (VO2max)",
  "version": "1.1",
  "supplementary": true,
  "intent": {
    "primary_goal": "conditioning",
    "secondary_goals": [
      "aerobic_capacity"
    ],
    "notes": "Lunch-break VO2max session on a treadmill, about 55 min: 8 min warm-up, 4 x 4 min hard with 3 min easy walking between (keep walking 3-5 min after the last one), then floor core (hollow hold, side plank) and hip mobility. Zero finger load, but systemically hard: at most one per week, never on the day of or the day before a maximal or limit climbing session."
  },
  "compatibility": {
    "slot": [
      "lunch_short",
      "short"
    ],
    "sports": [
      "climbing"
    ]
  },
  "required_equipment": [
    "treadmill"
  ],
  "time_budget": {
    "target_duration_min": 55,
    "hard_cap_min": 55
  },
  "tags": {
    "hard": false,
    "finger": false,
    "hiit": true
  },
  "modules": [
    {
      "block_id": "treadmill_warmup",
      "required": true,
      "priority": 100,
      "module_role": "general_warmup",
      "notes": "Progressive warm-up on the same treadmill: brisk incline walk building to an easy jog.",
      "selection": {
        "primary": {
          "exercise_id": "general_pulse_raise",
          "prescription_overrides": {
            "work_seconds": 480,
            "notes": "Warm-up on the treadmill: 8 min, start as a brisk incline walk and build to an easy jog for the last 2 min."
          },
          "filters": {
            "role": [
              "warmup"
            ],
            "domain": [
              "aerobic_capacity"
            ],
            "intensity_max": "low"
          }
        }
      }
    },
    {
      "block_id": "hiit_intervals",
      "required": true,
      "priority": 90,
      "module_role": "primary",
      "notes": "The 4x4 VO2max intervals. Strict pin: without a treadmill the block fails instead of falling back to an easy incline walk, so the session is never reported as HIIT when it is not.",
      "selection": {
        "primary": {
          "exercise_id": "treadmill_hiit_4x4",
          "pin_strict": true,
          "filters": {
            "role": [
              "conditioning"
            ],
            "domain": [
              "aerobic_capacity"
            ],
            "pattern": [
              "locomotion"
            ],
            "equipment": [
              "treadmill"
            ]
          }
        }
      }
    },
    {
      "block_id": "core_anti_extension",
      "required": false,
      "priority": 70,
      "module_role": "accessory",
      "notes": "Floor core after the intervals: hollow hold. The legs are tired, the trunk is not.",
      "selection": {
        "primary": {
          "exercise_id": "core_hollow_hold",
          "prescription_overrides": {
            "sets": 3,
            "deload_sets": 2,
            "work_seconds": 30,
            "rest_between_sets_seconds": 45,
            "notes": "3 x 30 s hollow hold: lower back pressed to the floor, arms by the ears, heels a hand off the floor. Shorten the lever (knees bent) before the back lifts."
          },
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "core"
            ],
            "pattern": [
              "anti_extension"
            ],
            "intensity_max": "high"
          }
        }
      }
    },
    {
      "block_id": "core_lateral",
      "required": false,
      "priority": 68,
      "module_role": "accessory",
      "notes": "Floor core, lateral chain: side plank on the forearm.",
      "selection": {
        "primary": {
          "exercise_id": "side_plank",
          "prescription_overrides": {
            "sets": 3,
            "deload_sets": 2,
            "work_seconds": 30,
            "rest_between_sets_seconds": 30,
            "notes": "3 x 30 s per side, elbow under the shoulder, hips high in one line from head to feet."
          },
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "core"
            ],
            "pattern": [
              "anti_lateral_flexion"
            ],
            "intensity_max": "medium"
          }
        }
      }
    },
    {
      "block_id": "hip_mobility",
      "required": false,
      "priority": 60,
      "module_role": "cooldown",
      "notes": "Hip mobility to close, while the heart rate comes down.",
      "selection": {
        "primary": {
          "exercise_id": "hip_opener_flow",
          "prescription_overrides": {
            "work_seconds": 480,
            "notes": "8 min: hold each hip position 45-60 s, breathe deeply. Optional."
          },
          "filters": {
            "role": [
              "cooldown"
            ],
            "domain": [
              "mobility",
              "flexibility"
            ],
            "intensity_max": "low"
          }
        }
      }
    }
  ]
}

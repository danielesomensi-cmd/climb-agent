{
  "id": "boulder_circuit_gym",
  "name": "Boulder Circuit (Gym — Volume & Movement Quality)",
  "version": "1.1",
  "intent": {
    "primary_goal": "volume_climbing",
    "secondary_goals": [
      "aerobic_capacity",
      "technique_footwork",
      "core"
    ],
    "notes": "Circuit bouldering at -3/-4 from boulder flash grade. Continuous movement, linked problems, focus on movement quality and aerobic base on boulders. Medium intensity, high volume."
  },
  "compatibility": {
    "slot": [
      "long"
    ],
    "sports": [
      "climbing"
    ]
  },
  "required_equipment": [
    "gym_boulder"
  ],
  "boulder_fallback": null,
  "time_budget": {
    "target_duration_min": 85,
    "hard_cap_min": 105
  },
  "modules": [
    {
      "template_id": "warmup_climbing",
      "required": true,
      "priority": 100,
      "module_role": "general_warmup"
    },
    {
      "block_id": "technique_drill",
      "required": false,
      "priority": 65,
      "module_role": "secondary",
      "order": "after_warmup",
      "notes": "One technique drill with one measurable target, right after the warm-up while fresh (Daniele, 2026-10-04: every session that is not pure recovery has a technique or try-hard block with a measurable target; limiters: feet, then positioning).",
      "selection": {
        "primary": {
          "exercise_id": "sticky_feet",
          "prescription_overrides": {
            "notes": "3 x 4 easy boulders: every foot placed with zero noise and left where it landed. Target: count the placements you hear — aim for zero on the last set."
          }
        }
      }
    },
    {
      "block_id": "boulder_circuit_main",
      "required": true,
      "priority": 90,
      "module_role": "primary",
      "notes": "Circuit bouldering: 4-6 problems linked back-to-back at -3/-4 from flash grade. 3-4 circuits with 3-5 min rest between circuits. Focus on smooth movement, silent feet, no falling.",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "main"
            ],
            "domain": [
              "aerobic_capacity",
              "power_endurance"
            ],
            "pattern": [
              "climbing_limit_boulder",
              "climbing_continuous",
              "climbing_intervals"
            ]
          }
        }
      }
    },
    {
      "block_id": "pulling_maintenance",
      "rotation": "ab",
      "unloaded_only": true,
      "ab_pool": ["power_pullups_explosive", "archer_pullup", "one_arm_pullup_assisted"],
      "required": false,
      "priority": 70,
      "module_role": "secondary",
      "notes": "Pulling strength maintenance. Low volume, high intensity — this is not a development block.",
      "selection": {
        "primary": {
          "filters": {
            "role": [
              "main"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "pull_vertical"
            ]
          }
        }
      },
      "prescription": {
        "sets": 2,
        "reps": 4,
        "rest_between_sets_seconds": 180,
        "notes": "2 heavy sets, full recovery. If the specific work left you tired, drop a rep — never the load."
      }
    },
    {
      "template_id": "core_standard",
      "required": false,
      "priority": 60,
      "module_role": "secondary"
    },
    {
      "template_id": "antagonist_prehab",
      "required": true,
      "priority": 55,
      "module_role": "secondary"
    },
    {
      "template_id": "cooldown_stretch",
      "required": false,
      "priority": 40,
      "module_role": "cooldown"
    }
  ]
}

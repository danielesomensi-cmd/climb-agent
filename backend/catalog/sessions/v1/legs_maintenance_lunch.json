{
  "id": "legs_maintenance_lunch",
  "name": "Legs Maintenance + Foot Strength (Lunch)",
  "version": "1.0",
  "supplementary": true,
  "intent": {
    "primary_goal": "strength_general",
    "secondary_goals": [
      "joint_health"
    ],
    "notes": "Lunch-break leg maintenance at a weights gym: goblet squat and Romanian deadlift, plus two short foot-strength exercises (toe flexors and big-toe calf raises) for edging. The engine orders them with the generic phase sort, so they are not necessarily contiguous or at the end. About 35 min. Keep heavy legs out of the 48 h before a limit or outdoor day."
  },
  "compatibility": {
    "slot": [
      "lunch_short",
      "short"
    ],
    "sports": [
      "climbing"
    ]
  },
  "required_equipment": [
    "dumbbell"
  ],
  "time_budget": {
    "target_duration_min": 35,
    "hard_cap_min": 45
  },
  "tags": {
    "hard": false,
    "finger": false
  },
  "modules": [
    {
      "block_id": "pulse_raise",
      "required": true,
      "priority": 110,
      "module_role": "general_warmup",
      "notes": "Short pulse raise before loading the legs.",
      "selection": {
        "primary": {
          "exercise_id": "general_pulse_raise",
          "filters": {
            "role": [
              "warmup"
            ],
            "domain": [
              "aerobic_capacity"
            ],
            "intensity_max": "low"
          }
        }
      }
    },
    {
      "block_id": "squat_main",
      "required": true,
      "priority": 100,
      "module_role": "primary",
      "notes": "Knee-dominant squat: goblet squat, the same movement every time so the load can progress from feedback.",
      "selection": {
        "primary": {
          "exercise_id": "goblet_squat",
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "squat"
            ],
            "intensity_max": "medium"
          }
        }
      }
    },
    {
      "block_id": "hinge",
      "required": true,
      "priority": 90,
      "module_role": "secondary",
      "notes": "Hip hinge for the posterior chain: Romanian deadlift, the same movement every time so the load can progress from feedback.",
      "selection": {
        "primary": {
          "exercise_id": "romanian_deadlift",
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "hinge"
            ],
            "intensity_max": "medium"
          }
        }
      }
    },
    {
      "block_id": "foot_toe_flexors",
      "required": true,
      "priority": 80,
      "module_role": "accessory",
      "notes": "Foot strength: toe flexor isometrics, short dose.",
      "selection": {
        "primary": {
          "exercise_id": "toe_flexor_isometric",
          "prescription_overrides": {
            "sets": 2,
            "reps": 3,
            "work_seconds": 5,
            "rest_between_reps_seconds": 15,
            "rest_between_sets_seconds": 30,
            "notes": "Short lunch dose: 2 sets of 3 x 5 s per foot at about 90% effort, big toe first, then the lesser toes."
          },
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "calf_raise"
            ]
          }
        }
      }
    },
    {
      "block_id": "foot_edge_calf",
      "required": true,
      "priority": 70,
      "module_role": "accessory",
      "notes": "Foot strength: single-leg calf raise on an edge, weight over the big toe. Light load: the generic phase sort may place it before the main lifts.",
      "selection": {
        "primary": {
          "exercise_id": "edge_calf_raise_bigtoe",
          "prescription_overrides": {
            "sets": 2,
            "reps": 8,
            "rest_between_sets_seconds": 30,
            "notes": "Short lunch dose: 2 x 8 per leg on a 2-3 cm edge, 3 s up, 2 s hold over the big toe, 3 s down."
          },
          "filters": {
            "role": [
              "accessory"
            ],
            "domain": [
              "strength_general"
            ],
            "pattern": [
              "calf_raise"
            ]
          }
        }
      }
    }

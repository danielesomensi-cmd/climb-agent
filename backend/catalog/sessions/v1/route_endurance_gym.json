{
  "id": "route_endurance_gym",
  "name": "Route Endurance (Gym — Lead Aerobic Base)",
  "version": "1.1",
  "intent": {
    "primary_goal": "aerobic_capacity",
    "secondary_goals": ["power_endurance", "technique_lead"],
    "notes": "Lead-specific endurance session. Threshold climbing on routes + ARC on boulder/board as complement. Core aerobic base for route climbers."
  },
  "compatibility": {
    "slot": ["long"],
    "sports": ["climbing"]
  },
  "required_equipment": ["gym_routes"],
  "boulder_fallback": "boulder_circuit_gym",
  "time_budget": {
    "target_duration_min": 100,
    "hard_cap_min": 120
  },
  "modules": [
    {
      "template_id": "warmup_climbing",
      "required": true,
      "priority": 100,
      "module_role": "general_warmup"
    },
    {
      "block_id": "technique_drill",
      "required": false,
      "priority": 65,
      "module_role": "secondary",
      "order": "after_warmup",
      "notes": "One technique drill with one measurable target, right after the warm-up while fresh (Daniele, 2026-10-04: every session that is not pure recovery has a technique or try-hard block with a measurable target; limiters: feet, then positioning). Without rope routes the block is skipped (pin_exhausted: skip).",
      "selection": {
        "primary": {
          "exercise_id": "lead_precision_feet_above_bolt",
          "pin_exhausted": "skip",
          "prescription_overrides": {
            "sets": 1,
            "reps": 1,
            "notes": "1 route 2-3 grades below your onsight before the volume: every foot loaded and still for 3 s before a hand moves. Target: zero feet moved after placement on the whole route."
          }
        }
      }
    },
    {
      "block_id": "threshold_main",
      "required": true,
      "priority": 90,
      "module_role": "primary",
      "notes": "Threshold climbing on routes — 1 grade below lead onsight. 6x2min/1min rest.",
      "selection": {
        "primary": {
          "filters": {
            "role": ["main"],
            "domain": ["power_endurance"],
            "pattern": ["climbing_continuous"],
            "equipment": ["gym_routes"]
          }
        }
      }
    },
    {
      "block_id": "arc_complement",
      "required": false,
      "priority": 70,
      "module_role": "secondary",
      "notes": "ARC on boulder/board as aerobic complement post-threshold.",
      "selection": {
        "primary": {
          "filters": {
            "role": ["main"],
            "domain": ["aerobic_capacity", "regeneration"],
            "pattern": ["climbing_continuous"]
          }
        }
      }
    },
    {
      "template_id": "core_standard",
      "required": false,
      "priority": 60,
      "module_role": "secondary"
    },
    {
      "template_id": "antagonist_prehab",
      "required": true,
      "priority": 55,
      "module_role": "secondary"
    },
    {
      "template_id": "cooldown_stretch",
      "required": false,
      "priority": 40,
      "module_role": "cooldown"
    }
  ]
}

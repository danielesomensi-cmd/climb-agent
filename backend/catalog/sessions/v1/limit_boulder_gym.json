{
  "id": "limit_boulder_gym",
  "name": "Limit Bouldering (Projecting)",
  "version": "2.1",
  "intent": {
    "primary_goal": "limit_projecting",
    "secondary_goals": [
      "technique_boulder",
      "movement_quality",
      "core_tension"
    ],
    "notes": "Dedicated limit projecting session. Read the whole problem. Rest long. Quality over quantity. 3-4 attempts per boulder max, 5-8 min rest between problems for full neural recovery."
  },
  "compatibility": {
    "slot": ["long"],
    "sports": ["climbing"]
  },
  "required_equipment": ["gym_boulder"],
  "boulder_fallback": null,
  "time_budget": {
    "target_duration_min": 85,
    "hard_cap_min": 110
  },
  "modules": [
    {
      "template_id": "warmup_climbing",
      "required": true,
      "priority": 100,
      "module_role": "general_warmup"
    },
    {
      "block_id": "finger_rampup",
      "required": false,
      "priority": 88,
      "module_role": "general_warmup",
      "order": "after_warmup",
      "notes": "Finger ramp-up on the hangboard after the easy boulders of the warm-up, before the limit work: progressive hangs from big holds to the edge you will pull on, never to failure. Where the gym has no hangboard the block is skipped (pin_exhausted: skip).",
      "selection": {
        "primary": {
          "exercise_id": "hang_rampup_progressive",
          "pin_exhausted": "skip"
        }
      }
    },
    {
      "block_id": "technique_drill",
      "required": false,
      "priority": 65,
      "module_role": "secondary",
      "order": "after_warmup",
      "notes": "One technique drill with one measurable target, right after the warm-up while fresh (Daniele, 2026-10-04: every session that is not pure recovery has a technique or try-hard block with a measurable target; limiters: feet, then positioning).",
      "selection": {
        "primary": {
          "exercise_id": "no_readjust_drill",
          "prescription_overrides": {
            "sets": 1,
            "work_seconds": 600,
            "notes": "10 min on boulders 3-4 grades below your max: every foot goes on once and stays — no readjusting, no sliding, no tapping. Target: zero readjustments on your last 3 problems (count them)."
          }
        }
      }
    },
    {
      "block_id": "limit_projecting",
      "rotation": "phase_anchor",
      "anchor_axis": "finger",
      "anchor_priority": {"tested": ["limit_bouldering", "spray_wall_limit", "board_limit_boulders"], "untested": ["limit_bouldering", "spray_wall_limit", "board_limit_boulders"]},
      "required": true,
      "priority": 90,
      "module_role": "primary",
      "notes": "Limit bouldering: 4-6 problems at V_max to V_max-1. Project mindset: read, visualize, attempt, analyze. 3-4 attempts per problem max. Rest 5-8 min between problems (FULL neural recovery).",
      "selection": {
        "primary": {
          "filters": {
            "role": ["main"],
            "domain": ["power", "technique_boulder"],
            "pattern": ["climbing_limit_boulder"]
          }
        }
      }
    },
    {
      "block_id": "supplementary_pulling",
      "rotation": "ab",
      "unloaded_only": true,
      "ab_pool": ["power_pullups_explosive", "archer_pullup", "one_arm_pullup_assisted"],
      "required": false,
      "priority": 70,
      "module_role": "secondary",
      "notes": "1-2 sets heavy pulling to complement limit bouldering. Archer or weighted pull-up.",
      "selection": {
        "primary": {
          "filters": {
            "role": ["main"],
            "domain": ["strength_general"],
            "pattern": ["pull_vertical"]
          },
          "pick": 1
        }
      }
    },
    {
      "template_id": "core_standard",
      "required": false,
      "priority": 60,
      "module_role": "secondary"
    },
    {
      "template_id": "antagonist_prehab",
      "required": true,
      "priority": 55,
      "module_role": "secondary"
    },
    {
      "template_id": "cooldown_stretch",
      "required": false,
      "priority": 40,
      "module_role": "cooldown"
    }
  ]
}

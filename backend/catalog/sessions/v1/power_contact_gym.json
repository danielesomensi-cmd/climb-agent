{
  "id": "power_contact_gym",
  "name": "Power & Contact Strength (Gym)",
  "version": "2.1",
  "intent": {
    "primary_goal": "contact_strength",
    "secondary_goals": [
      "power",
      "core_tension",
      "joint_health"
    ],
    "notes": "Limit bouldering on FRESH fingers. NO max hangboard — fingers must be fresh for the wall. Campus work optional if energy remains."
  },
  "compatibility": {
    "slot": ["long"],
    "sports": ["climbing"]
  },
  "required_equipment": ["gym_boulder"],
  "boulder_fallback": null,
  "time_budget": {
    "target_duration_min": 100,
    "hard_cap_min": 120
  },
  "modules": [
    {
      "template_id": "warmup_climbing",
      "required": true,
      "priority": 100,
      "module_role": "general_warmup"
    },
    {
      "block_id": "finger_rampup",
      "required": false,
      "priority": 88,
      "module_role": "general_warmup",
      "order": "after_warmup",
      "notes": "Finger ramp-up on the hangboard after the easy boulders of the warm-up, before the limit work: progressive hangs from big holds to the edge you will pull on, never to failure. Where the gym has no hangboard the block is skipped (pin_exhausted: skip).",
      "selection": {
        "primary": {
          "exercise_id": "hang_rampup_progressive",
          "pin_exhausted": "skip"
        }
      }
    },
    {
      "block_id": "technique_drill",
      "required": false,
      "priority": 65,
      "module_role": "secondary",
      "order": "after_warmup",
      "notes": "One technique drill with one measurable target, right after the warm-up while fresh (Daniele, 2026-10-04: every session that is not pure recovery has a technique or try-hard block with a measurable target; limiters: feet, then positioning).",
      "selection": {
        "primary": {
          "exercise_id": "tech_hard_target",
          "prescription_overrides": {
            "notes": "4 sets, one rep per foot: from two matched jugs on an overhanging wall, laser-place the foot on 5-8 footholds, each only for a moment. Target: every foot lands silent and exact at the first touch — count the misses, aim for 0-1 per set."
          }
        }
      }
    },
    {
      "block_id": "limit_bouldering",
      "rotation": "phase_anchor",
      "anchor_axis": "finger",
      "anchor_priority": {"tested": ["system_board_limit", "board_limit_boulders", "spray_wall_limit", "limit_bouldering"], "untested": ["spray_wall_limit", "limit_bouldering", "board_limit_boulders", "system_board_limit"]},
      "required": true,
      "priority": 90,
      "module_role": "primary",
      "notes": "Limit bouldering at max grade. FRESH fingers — this is the primary stimulus. Full rest between attempts.",
      "selection": {
        "primary": {
          "filters": {
            "role": ["main"],
            "domain": ["power", "contact_strength"],
            "pattern": ["climbing_limit_boulder"]
          }
        }
      }
    },
    {
      "block_id": "campus_power",
      "rotation": "phase_anchor",
      "anchor_axis": "finger",
      "anchor_priority_by_phase": {"strength_power": {"tested": ["campus_max_ladders", "campus_laddering_feet_off", "campus_bumps", "campus_touches", "campus_laddering_feet_on"], "untested": ["campus_laddering_feet_on", "campus_touches", "campus_laddering_feet_off"], "anchor_exclude": {"untested": ["campus_max_ladders", "campus_double_dyno", "campus_bumps", "campus_switches", "campus_laddering_down"]}}},
      "required": false,
      "priority": 80,
      "module_role": "secondary",
      "notes": "Campus laddering or bumps. Fallback to overcoming isometrics or power slap when campus board unavailable.",
      "selection": {
        "primary": {
          "filters": {
            "role": ["main"],
            "domain": ["contact_strength"],
            "pattern": ["campus_ladder", "isometric_explosive", "explosive_brief", "explosive_touch"],
            "equipment": ["campus_board"]
          }
        }
      }
    },
    {
      "template_id": "core_standard",
      "required": false,
      "priority": 60,
      "module_role": "secondary"
    },
    {
      "template_id": "antagonist_prehab",
      "required": true,
      "priority": 65,
      "module_role": "secondary"
    },
    {
      "template_id": "cooldown_stretch",
      "required": false,
      "priority": 40,
      "module_role": "cooldown"
    }
  ]
}

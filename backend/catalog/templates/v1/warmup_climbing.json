{
  "id": "warmup_climbing",
  "name": "Climbing Warm-up (Module)",
  "version": "1.0",
  "category": "warmup_module",
  "sports": ["climbing"],
  "disciplines": ["boulder", "lead", "mixed"],

  "compatible_slots": ["short", "medium", "long"],
  "requires_environment": { "equipment_any_of": ["none", "band", "mat", "floor"] },

  "goals": ["increase_body_temperature", "improve_joint_readiness", "hip_mobility", "activate_shoulders"],
  "stress_tags": { "fingers": "none", "cns": "low", "elbow": "low", "skin": "none" },

  "scheduling_rules": {
    "max_per_day": 2,
    "notes": "Use before any climbing session. Includes bouldering ramp-up on easy problems."
  },

  "blocks": [
    {
      "block_id": "pulse_raise",
      "type": "warmup_general",
      "mode": "select_one",
      "exercise_id": "general_pulse_raise",
      "role": ["warmup"],
      "domain": ["aerobic_capacity"]
    },
    {
      "block_id": "mobility",
      "type": "warmup_general",
      "mode": "select_one",
      "exercise_id": "dynamic_mobility_flow",
      "role": ["warmup"],
      "domain": ["mobility", "flexibility"]
    },
    {
      "block_id": "hip_mobility",
      "type": "warmup_general",
      "mode": "select_one",
      "exercise_id": "active_hip_mobility",
      "role": ["warmup"],
      "domain": ["flexibility", "mobility"],
      "prescription": { "sets": 1, "work_seconds": 480 },
      "notes": ["Dynamic hip CARs, leg swings, 90/90 switches. Improves high-step and drop-knee range."]
    },
    {
      "block_id": "upper_activation",
      "type": "activation",
      "mode": "select_one",
      "role": ["warmup", "prehab"],
      "domain": ["prehab_shoulder"],
      "prescription": { "sets_range": [2, 3], "reps_range": [8, 15], "rest_seconds_range": [30, 60] },
      "notes": ["Light scap/rotator cuff activation. Band pull-aparts or shoulder CARs. Submaximal."]
    },
    {
      "block_id": "climbing_activation",
      "type": "warmup_specific",
      "mode": "select_one",
      "exercise_id": "warmup_easy_boulders",
      "role": ["warmup"],
      "domain": ["technique_footwork"],
      "prescription": { "sets": 1, "work_seconds": 600 },
      "notes": ["Progressive easy boulders to warm up fingers, tendons, and movement patterns before hard climbing."]
    }
  ],

  "module_notes": "Climbing-specific warm-up. Includes bouldering ramp-up on easy problems as part of pulse raise."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolved_day_log_entry.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "log_version",
    "date",
    "status",
    "session_ids",
    "summary"
  ],
  "properties": {
    "log_version": {
      "const": "closed_loop.v1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "skipped"
      ]
    },
    "plan_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "gym_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned": {
      "type": "array"
    },
    "actual": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "exercise_feedback_v1": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exerciseFeedback"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_count",
        "status",
        "categories",
        "session_ids"
      ],
      "properties": {
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "done",
            "skipped"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schema_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_feedback_v1": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exerciseFeedback"
      }
    },
    "feedback_contract": {
      "type": "integer",
      "description": "A295: 2 = measured-feedback contract (an omitted label means not rated)."
    },
    "pain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "site": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "fingers",
            "elbow",
            "shoulder",
            "other",
            null
          ]
        }
      }
    }
  },
  "$defs": {
    "exerciseFeedback": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "exercise_id",
        "completed"
      ],
      "properties": {
        "exercise_id": {
          "type": "string",
          "minLength": 1
        },
        "feedback_label": {
          "type": "string",
          "enum": [
            "very_easy",
            "easy",
            "ok",
            "hard",
            "very_hard"
          ],
          "description": "A295: omitted when the athlete did not rate the exercise (not rated). Never null."
        },
        "completed": {
          "type": "boolean"
        },
        "used_total_load_kg": {
          "type": "number"
        },
        "used_external_load_kg": {
          "type": "number"
        },
        "used_grade": {
          "type": "string"
        },
        "surface_selected": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "last_set_reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "A295: reps on the last set (pull-ups: AMRAP stopping one short of failure; double progression)."
        },
        "hang_margin": {
          "type": "string",
          "enum": [
            "failed",
            "0-2",
            "3-5",
            ">5"
          ],
          "description": "A295: seconds the athlete could still have held the last hang."
        },
        "hang_held_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "description": "A295: timed hold of the last rep (guided overhold, capped at target+6 s)."
        },
        "target_reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "A295: double-progression target the client showed."
        },
        "prescribed_sets": {
          "type": "number",
          "description": "A295: attached by the router."
        },
        "prescribed_work_seconds": {
          "type": "number",
          "description": "A295: attached by the router."
        },
        "completed_sets": {
          "type": "number"
        },
        "completed_reps": {
          "type": "number",
          "description": "Repeater tests only (B133)."
        }
      }
    }
  }
}
